#!/bin/sh

set -e

echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> Installing required packages"
PKG_LIB=""
PKG_DEV="tzdata"
docker-install -r -u ${PKG_LIB} ${PKG_DEV}
echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> OK"
echo

echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> Executing bootstrap"
#config
TARGET_OUTPUT="/output"
TARGET_TIMEZONE="Asia/Seoul"

ALPINE_EDITION="${BUILD_EDITION:-edge}"
if [ "${ALPINE_EDITION}" = "latest" ]; then
	ALPINE_EDITION="latest-stable"
fi
ALPINE_ARCH=$(uname -m)
ALPINE_MIRROR=http://mirror.xtom.com.hk/alpine

echo "Current version : ${ALPINE_EDITION}"

#basic
mkdir -p ${TARGET_OUTPUT}/usr/bin ${TARGET_OUTPUT}/usr/sbin ${TARGET_OUTPUT}/usr/lib
ln -sf usr/bin ${TARGET_OUTPUT}/bin
ln -sf usr/sbin ${TARGET_OUTPUT}/sbin
ln -sf usr/lib ${TARGET_OUTPUT}/lib

#init
apk --repository ${ALPINE_MIRROR}/latest-stable/main --no-cache --allow-untrusted --root "${TARGET_OUTPUT}" --initdb add busybox alpine-baselayout alpine-keys apk-tools libc-utils alpine-release

#mirror
if [ "${ALPINE_EDITION}" = "edge" ]; then
	echo "${ALPINE_MIRROR}/edge/main" >> ${TARGET_OUTPUT}/etc/apk/repositories
	echo "${ALPINE_MIRROR}/edge/community" >> ${TARGET_OUTPUT}/etc/apk/repositories
	echo "${ALPINE_MIRROR}/edge/testing" >> ${TARGET_OUTPUT}/etc/apk/repositories
	echo "${ALPINE_MIRROR}/latest-stable/main" > ${TARGET_OUTPUT}/etc/apk/repositories
	echo "${ALPINE_MIRROR}/latest-stable/community" >> ${TARGET_OUTPUT}/etc/apk/repositories
else
	echo "${ALPINE_MIRROR}/${ALPINE_EDITION}/main" > ${TARGET_OUTPUT}/etc/apk/repositories
	echo "${ALPINE_MIRROR}/${ALPINE_EDITION}/community" >> ${TARGET_OUTPUT}/etc/apk/repositories
	echo "@${ALPINE_EDITION}main ${ALPINE_MIRROR}/${ALPINE_EDITION}/main" >> ${TARGET_OUTPUT}/etc/apk/repositories
	echo "@${ALPINE_EDITION}community  ${ALPINE_MIRROR}/${ALPINE_EDITION}/community" >> ${TARGET_OUTPUT}/etc/apk/repositories
fi

#resolve
cat <<- EOF > ${TARGET_OUTPUT}/etc/resolv.conf
nameserver 1.1.1.1
nameserver 1.0.0.1
EOF

#timezone
if [ -e ${TARGET_OUTPUT}/usr/share/zoneinfo/${TARGET_TIMEZONE} ]; then
	echo "${TARGET_TIMEZONE}" > ${TARGET_OUTPUT}/etc/timezone
	rm -rf ${TARGET_OUTPUT}/etc/localtime
	ln -sf /usr/share/zoneinfo/${TARGET_TIMEZONE} ${TARGET_OUTPUT}/etc/localtime
elif [ -e /usr/share/zoneinfo/${TARGET_TIMEZONE} ]; then
	echo "${TARGET_TIMEZONE}" > ${TARGET_OUTPUT}/etc/timezone
	rm -rf ${TARGET_OUTPUT}/etc/localtime
	cp /usr/share/zoneinfo/${TARGET_TIMEZONE} ${TARGET_OUTPUT}/etc/localtime
fi

#script
cp /usr/local/bin/docker-install.alpine ${TARGET_OUTPUT}/usr/local/bin/docker-install
cp /usr/local/bin/docker-adduser ${TARGET_OUTPUT}/usr/local/bin/
cp /usr/local/bin/docker-chown ${TARGET_OUTPUT}/usr/local/bin/
cp /usr/local/bin/docker-run ${TARGET_OUTPUT}/usr/local/bin/

echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> OK"
echo

